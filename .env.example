# Copy this to .env.local and fill in the values. .env.local is gitignored;
# this file is not, so never put a real secret here.
#
#     cp .env.example .env.local
#
# Most of the site runs with none of these. All 21 PDF tools — merge, split,
# compress, convert, sign, watermark and the rest — work on an empty file,
# because they run in this server rather than calling anything out. What the
# variables buy you is accounts and the AI features.


# --- Accounts, saved documents, chats ---------------------------------------
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup.
# These ship to the browser by design, so they are not secrets. They are baked
# in at build time, so changing one means rebuilding, not just restarting.
#
# Without them: sign-in, the dashboard, saved documents and chat history fail.
# Everything else still works.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# --- Verifying the session cookie in proxy.ts -------------------------------
# These are the opposite: a service account key is a full admin credential. It
# can read and write every document and mint a token for any user. It must stay
# on the server, out of the repo and out of chats, screenshots and issues.
#
# Do not copy these by hand. The JSON holds private_key and private_key_id on
# adjacent lines and grabbing the wrong one is easy. Download the key from
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key, then:
#
#     node scripts/import-service-account.mjs <path-to-downloaded.json>
#
# It fills in all three and never prints the key. Delete the JSON afterwards.
#
# Without them: proxy.ts cannot verify anyone, so it fails closed and the
# signed-in area redirects everybody to /login — including signed-in users.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# --- The AI tools -----------------------------------------------------------
# Summarise, translate, grammar, OCR and chat call the separate service in
# ai-service/, which needs its own ai-service/.env holding GOOGLE_API_KEY.
# Chat additionally wants a Chroma server; the other four do not.
#
# Leave this unset locally — it already defaults to http://localhost:8001.
# Without the service running: those five tools return an error. The other 21
# are unaffected.
# AI_SERVICE_URL=http://localhost:8001


# --- Absolute URLs ----------------------------------------------------------
# Used by sitemap.xml, canonical tags and Open Graph images. Falls back to the
# Railway or Vercel host, then http://localhost:3000, so it is only needed once
# there is a custom domain. Set it in production; skip it locally.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Lemon Squeezy card payments --------------------------------------------
# The customer pays on Lemon Squeezy's hosted checkout and the plan turns on by
# itself, without an admin confirming anything. This is the only way to pay:
# the Payoneer flow that used to sit behind checkout has been removed.
#
# Without these: checkout offers no payment button at all and points the
# customer at /contact instead, which is the only remaining route to a paid
# plan. A plan whose variant id is missing is treated the same way.
#
# LEMONSQUEEZY_API_KEY   Settings -> API -> create an API key. Server secret:
#                        it can read your store and create checkouts.
# LEMONSQUEEZY_STORE_ID  Settings -> Stores, the numeric id (not the subdomain).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# The signing secret for the webhook, from Settings -> Webhooks -> your webhook.
# This is what proves an incoming payment notification is really from Lemon
# Squeezy. The endpoint grants paid plans, so without a correct secret every
# real payment is rejected — and with a guessable one, anybody who finds the URL
# can grant themselves Business.
#
# Point the webhook at:  https://your-domain.com/api/billing/webhook/lemonsqueezy
# Subscribe it to:       order_created, order_refunded,
#                        subscription_created, subscription_updated,
#                        subscription_cancelled, subscription_resumed,
#                        subscription_expired, subscription_paused,
#                        subscription_unpaused, subscription_plan_changed,
#                        subscription_payment_success,
#                        subscription_payment_failed,
#                        subscription_payment_recovered,
#                        subscription_payment_refunded
# Register it in LIVE mode for real payments; a test-mode webhook never
# receives them.
#
# order_refunded and subscription_payment_refunded are what end a plan that was
# paid for and then refunded. Leave them unsubscribed and a refunded customer
# keeps everything they were charged for.
LEMONSQUEEZY_WEBHOOK_SECRET=

# One variant id per plan and billing cycle. A Lemon Squeezy product holds its
# prices as variants, so monthly and yearly Pro are two variants of one product.
# Find them at Products -> the product -> the variant -> the id in the URL.
#
# The prices these charge must match plans.ts, which is what the site displays.
# Checkout checks this at the moment of sale and refuses when they differ, so a
# mismatch shows up as card payments failing, with both figures in the server
# log. Yearly variants must charge twelve times the yearly column.
#
# Any plan left blank simply is not offered by card; the rest still are.
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=

# --- Import from Google Drive and Dropbox ----------------------------------
# Adds "Google Drive" and "Dropbox" buttons under every tool's upload box. Each
# source appears only when its keys are set; leave them blank and the upload
# box looks exactly as it did.
#
# iCloud Drive needs nothing here. Apple offers no picker a website can call —
# on iPhone, iPad and Mac the device's own file dialog already opens onto
# iCloud Drive, so the upload box shows an "iCloud Drive" button there that
# opens exactly that.
#
# Google Drive — console.cloud.google.com:
#   1. Create or pick a project; enable "Google Picker API" and "Google Drive API".
#   2. APIs & Services -> Credentials -> Create API key. Restrict it to those two
#      APIs and to your site's domain.            -> NEXT_PUBLIC_GOOGLE_PICKER_API_KEY
#   3. Credentials -> Create OAuth client ID -> Web application. Add your site to
#      "Authorised JavaScript origins".          -> NEXT_PUBLIC_GOOGLE_CLIENT_ID
#   4. The project NUMBER (not its id), from the project dashboard.
#                                                -> NEXT_PUBLIC_GOOGLE_APP_ID
#   The app only asks for the drive.file scope, which reaches the files a person
#   picks and nothing else, and does not need Google's restricted-scope review.
#   The OAuth consent screen still has to be published before people outside
#   your test-users list can sign in.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Dropbox — dropbox.com/developers/apps:
#   Create app -> Scoped access -> the app key. Under "Chooser / Saver / Embedder
#   domains", add your site's domain, or Dropbox refuses to open the chooser.
NEXT_PUBLIC_DROPBOX_APP_KEY=
